# Sample checks only. No Nebius or Tavily call is made.
# Set this to false only when you mean to spend credits.
DEMO_MODE=true

# Nebius Token Factory — https://tokenfactory.nebius.com/
# OpenAI-compatible. Never commit a real key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Lightning classifies. Nano writes the verdict.
# The app escalates the verdict to Super only when the first pass is unsure
# or the amount is at least GH¢500. Ultra is rejected. There is no separate guard model.
# The vision model runs only when someone uploads a photo with no typed text.
NEBIUS_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
NEBIUS_MODEL_CLASSIFY=nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL_VERDICT=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional lookups. Both stay off with no key and no flag, including in sample mode.
# SCAMCHECK_RDAP=1
# SAFE_BROWSING_API_KEY=

# WhatsApp stub. Nothing is sent to Meta until WHATSAPP_SEND=1 and the token is set.
# When WHATSAPP_APP_SECRET is set, POST must include a valid X-Hub-Signature-256.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_SEND=

# Trust the right-most X-Forwarded-For hop only behind your own proxy. Render sets this to 1.
# TRUST_PROXY=1
# HMAC salt for Scam Radar phone hashes. At least 16 characters. No default. Never commit a real value.
# RADAR_SALT=
# Admin routes /api/admin/metrics and /api/admin/llm. At least 16 characters.
# ADMIN_SECRET=

# Per-request ceiling, and the total granted across one check.
# Code will not go above 1000 tokens on one call, or 2400 across one check.
NEBIUS_MAX_TOKENS=1000
NEBIUS_CHECK_TOKEN_CAP=2400

# Tavily web search — https://tavily.com
TAVILY_API_KEY=
